{
  "name": "podcast-agent",
  "version": "1.0.0",
  "description": "Autonomous AI agent that fetches, analyzes, and summarizes podcast episodes into structured Markdown digests",
  "type": "module",
  "scripts": {
    "start": "tsx podcast-agent.ts",
    "start:podcast": "tsx podcast-agent.ts --podcast",
    "start:episode": "tsx podcast-agent.ts --podcast --episode",
    "test": "tsx podcast-agent.ts --podcast --test"
  },
  "dependencies": {
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
